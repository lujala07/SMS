{
  "name": "server",
  "version": "1.0.0",
  "description": "Backend API for the Role-Based Student Academic Management System",
  "main": "dist/server.js",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "type-check": "tsc --noEmit",
